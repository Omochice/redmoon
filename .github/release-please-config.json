{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "json",
          "path": "redmoon/src/build/version.json",
          "jsonpath": "$.version"
        },
        { "type": "generic", "path": "integration-test/moon.mod" },
        { "type": "generic", "path": "keyring/moon.mod" },
        { "type": "generic", "path": "mcp/moon.mod" },
        { "type": "generic", "path": "redmine/moon.mod" },
        { "type": "generic", "path": "redmine-plugins/moon.mod" },
        { "type": "generic", "path": "redmoon/moon.mod" },
        { "type": "generic", "path": "schema/moon.mod" }
      ],
      "initial-version": "0.1.0",
      "draft": true,
      "force-tag-creation": true
    }
  }
}
